; The ordinary Mentci Signal contract.
;
; The human interface surface: projected interface state, approval questions
; and their verdicts, notification and pane mutation, and the parked-request
; and intercept-policy views Mentci presents on Criome's behalf.
Signal
[ signal_criome:[ ParkedRequestQuery AuthorizationRequestSlot ActiveInterceptPolicies
                  InterceptPolicy ParkedRequestIdentifier ParkedRequestResolution
                  InterceptPolicyProposal ParkedRequestSnapshot InterceptPolicyIdentifier
                  ParkedRequestAnswer InterceptPolicyCancellation ] ]
[ RetractInterfaceObservation.SubscriptionToken
  PushUpdate.InterfaceUpdate
  ObserveInterfaceState.InterfaceStateObservation
  ListInterceptPolicies.InterceptPolicyObservation
  FetchParkedRequests.ParkedRequestQuery
  PresentQuestion.QuestionProposal
  ReplaceInterceptPolicy.InterceptPolicyProposal
  CreateInterceptPolicy.InterceptPolicyProposal
  CancelInterceptPolicy.InterceptPolicyCancellation
  ProposeEditedAnswer.AnswerProposal
  AnswerQuestion.ApprovalVerdict
  AnswerParkedRequest.ParkedRequestAnswer ]
[ InterfaceObservationStarted.InterfaceObservationOpened
  UpdateApplied.UpdateAccepted
  ParkedRequestAnswered.ParkedRequestResolution
  VerdictRecorded.VerdictAccepted
  AnswerProposalAccepted.AnswerProposalAdmitted
  QuestionAccepted.QuestionPresented
  ParkedRequestsFetched.ParkedRequestSnapshot
  InterceptPolicyCancelled.InterceptPolicyIdentifier
  InterceptPolicyReplaced.InterceptPolicy
  InterceptPoliciesListed.ActiveInterceptPolicies
  InterceptPolicyCreated.InterceptPolicy
  RequestRejected.Rejection
  InterfaceObservationClosed.InterfaceObservationRetracted ]
[ ApprovalSource.[ CriomeEscalation.AuthorizationRequestSlot AgentQuestion CriomeInterception.ParkedRequestIdentifier LocalSystemPrompt ]
  InterfaceInterest.[ PendingQuestions Notifications StatusOnly FullInterfaceState ]
  InterfaceUpdate.{ UpdateIdentifier InterfaceMutation }
  AnswerProposalAdmitted.{ ProposalIdentifier QuestionIdentifier ProposalDigest RevisionCounter }
  ApprovalQuestion.{ QuestionIdentifier QuestionProposal }
  CriomeAccess.[ ReadWrite ReadOnly ]
  RejectionReason.[ UnsupportedMutation UnknownQuestion MalformedRequest UnauthorizedProjection UnknownSubscriber QuestionAlreadyAnswered ]
  ProposalDigest.String
  NotificationSlice.[ Empty Present.NotificationText ]
  SubscriptionToken.String
  AnswerText.String
  ApprovalVerdict.{ QuestionIdentifier ApprovalDecision SubscriberName }
  ProposalIdentifier.String
  InterfaceMutation.[ SetPaneContent.PaneContent PostNotification.NotificationText PresentApprovalQuestion.QuestionProposal WithdrawApprovalQuestion.QuestionIdentifier ClearPane.PaneLabel SetStatus.StatusText ]
  UpdateIdentifier.String
  QuestionIdentifier.String
  RevisionCounter.Integer
  StatusText.String
  VerdictAccepted.{ QuestionIdentifier ApprovalDecision TimestampNanos }
  InterfaceObservationRetracted.{ SubscriptionToken }
  InterfaceProjection.[ StatusProjection.StatusText FullProjection.InterfaceState NotificationProjection.NotificationSlice PendingQuestionsProjection.PendingQuestionsView ]
  InterceptPolicyObservation.{}
  Rejection.{ RejectionReason }
  ExplanationText.String
  ComponentLabel.String
  InterfaceObservationOpened.{ SubscriptionToken ProjectedInterfaceState }
  ApprovalDecision.[ Reject ApproveSuggestedAnswer Defer ]
  PromptText.String
  TimestampNanos.Integer
  NotificationText.String
  UpdateAccepted.{ UpdateIdentifier RevisionCounter }
  ProjectedInterfaceState.{ RevisionCounter InterfaceProjection }
  AnswerProposal.{ QuestionIdentifier AnswerText SubscriberName }
  SubscriberName.String
  QuestionPresented.{ QuestionIdentifier RevisionCounter TimestampNanos }
  PaneLabel.String
  QuestionContext.{ ContextLabel ContextBody }
  InterfaceState.{ RevisionCounter StatusText NotificationText PaneContent ApprovalQuestion CriomeAccess }
  PendingQuestionsView.{ ApprovalQuestion }
  ContextLabel.String
  InterfaceStateObservation.{ SubscriberName InterfaceInterest }
  PaneContent.{ PaneLabel ContextBody }
  ContextBody.String
  QuestionProposal.{ ApprovalSource PromptText AnswerText ExplanationText QuestionContext } ]
